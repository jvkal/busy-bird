{
  "name": "busy-bird",
  "productName": "Busy Bird",
  "version": "0.1.0",
  "description": "鸟儿飞来飞去的 magpie 桌面挂件 · A tiny desktop perch where a bird carries every magpie request.",
  "main": "src/main.js",
  "exports": {
    "./server": "./plugin/server.mjs"
  },
  "author": "jvkal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvkal/busy-bird.git"
  },
  "homepage": "https://github.com/jvkal/busy-bird#readme",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "electron",
    "desktop-widget",
    "windows",
    "busy-bird"
  ],
  "files": [
    "src",
    "web",
    "plugin",
    "assets",
    "tools",
    "启动挂件.bat",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "hooks": "./plugin/launch.hooks.mjs",
    "icon": "https://raw.githubusercontent.com/jvkal/busy-bird/main/assets/icon.png"
  },
  "scripts": {
    "start": "electron .",
    "mock": "node tools/mock-server.mjs",
    "shot": "electron . --shot=docs\\screenshots\\bird.png --demo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "electron": "^39.8.7"
  }
}
